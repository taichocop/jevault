{
  "name": "jevault",
  "version": "0.5.0",
  "description": "An Obsidian plugin that suggests destination folders for Markdown notes.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && npm run verify:licenses",
    "verify:licenses": "node scripts/verify-license-notices.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "vitest run",
    "spike:typesafe": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts esbuild.config.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "eslint": "10.11.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
